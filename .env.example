# Build specification section 13.

DATABASE_URL=postgresql://bcj_app:password@localhost:5432/bcj_health

# 32+ random bytes, base64. Signs the participant and admin session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# 32 bytes, base64. Encrypts admin TOTP secrets with AES-256-GCM.
# Held only in the environment. If it is stored in the database or committed
# to the repository, encrypting the TOTP secrets achieves nothing.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Label shown in the authenticator app.
TOTP_ISSUER=BCJ Challenge

# The site's own absolute address, with no trailing slash. Every link in
# every email is built from this, so a wrong value here is invisible until a
# participant cannot open the link they were sent.
#   production -> https://health.bcjed.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail transport. The specification names Resend; BCJ chose SMTP on their own
# domain instead. With these unset, mail is logged to the console rather than
# sent, so the flows still work in development.
#   Implicit TLS  -> port 465
#   STARTTLS      -> port 587
# SMTP_SECURE is derived from the port unless you set it explicitly.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true
# Must be an address the SMTP account is allowed to send as. Sending through
# a Gmail mailbox with a From on another domain gets rewritten or filtered,
# so either use the mailbox's own address or set the domain up as a verified
# alias first.
EMAIL_FROM=BCJ Healthy Living <no-reply@bcjed.com>

# Shared secret for the nightly job. The cron route rejects any request
# without it.
CRON_SECRET=

# Two-factor authentication for organiser accounts.
# Specification section 2.3 requires it, because an organiser can change any
# score and read every participant's health data. Set to false only for local
# setup; leave it on in production.
ADMIN_REQUIRE_TOTP=true

# Optional. Comma separated. Blank disables the check.
# Works well for an office and badly for volunteers working from home.
ADMIN_IP_ALLOWLIST=
